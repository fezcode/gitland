<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>gitland</AssemblyName>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets/gitland.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Gitland.Core/Gitland.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <!-- Security backport for Avalonia's Linux D-Bus dependency (GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <AvaloniaResource Include="Assets/**" />
    <None Include="../../LICENSES/**" Link="LICENSES/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
